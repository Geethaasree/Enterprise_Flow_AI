# Copy to deploy/prod.env and fill secrets. Do not commit prod.env.
POSTGRES_USER=enterpriseflow
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=enterpriseflow
EF_JWT_SECRET=change-me-long-random-jwt-secret
EF_AUTH_REQUIRED=0
CORS_ORIGINS=*
LOG_LEVEL=INFO
API_HOST_PORT=8010
FRONTEND_HOST_PORT=3010
XAI_API_KEY=
XAI_MODEL=grok-4.5
MLFLOW_TRACKING_URI=file:/app/mlruns
MLFLOW_EXPERIMENT=enterpriseflow
