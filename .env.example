# EnterpriseFlow AI — local / compose defaults (placeholders only)
APP_NAME=EnterpriseFlow AI
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (compose service name "db")
POSTGRES_USER=enterpriseflow
POSTGRES_PASSWORD=enterpriseflow
POSTGRES_DB=enterpriseflow
DATABASE_URL=postgresql+psycopg://enterpriseflow:enterpriseflow@db:5432/enterpriseflow

# Redis (compose service name "redis")
REDIS_URL=redis://redis:6379/0

# Later phases (leave empty until needed)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
JWT_SECRET=change-me-in-production
MLFLOW_TRACKING_URI=
