# EnterpriseFlow AI — local / compose defaults (placeholders only)
APP_NAME=EnterpriseFlow AI
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (compose service name "db")
POSTGRES_USER=enterpriseflow
POSTGRES_PASSWORD=enterpriseflow
POSTGRES_DB=enterpriseflow
DATABASE_URL=postgresql+psycopg://enterpriseflow:enterpriseflow@db:5432/enterpriseflow

# Redis (compose service name "redis")
REDIS_URL=redis://redis:6379/0

# xAI / Grok (Phase 2). Leave empty to use Hermes SuperGrok OAuth (~/.hermes/auth.json).
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=60
XAI_MAX_RETRIES=2

# Later phases
JWT_SECRET=change-me-in-production
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=enterpriseflow
# Optional Databricks MLflow (see docs/DATABRICKS.md) — leave empty for local file store
# DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
# DATABRICKS_TOKEN=
# DATABRICKS_HTTP_PATH=
